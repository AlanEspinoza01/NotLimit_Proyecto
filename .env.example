# GEMINI_API_KEY: Requerida para realizar llamadas a la API de Gemini AI.
# AI Studio la incorpora automáticamente durante la ejecución a partir de los secretos del usuario.
# Los usuarios la configuran a través del panel de secretos en la interfaz de usuario de AI Studio.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: La URL donde está alojada esta aplicación.
# AI Studio la inserta automáticamente en tiempo de ejecución con la URL del servicio de Cloud Run.
# Se utiliza para enlaces autorreferenciales, devoluciones de llamada (callbacks) de OAuth y puntos finales (endpoints) de la API.
APP_URL="MY_APP_URL"
